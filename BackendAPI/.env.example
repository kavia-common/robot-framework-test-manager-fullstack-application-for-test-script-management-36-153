# Application Settings
APP_NAME=Robot Framework Test Manager
APP_VERSION=1.0.0
DEBUG=False
LOG_LEVEL=INFO

# Server
HOST=0.0.0.0
PORT=8000

# Database Configuration (PostgreSQL)
# These will be provided by the orchestrator
DATABASE_URL=postgresql://user:password@postgres:5432/testmanager
DB_POOL_SIZE=20
DB_MAX_OVERFLOW=10

# JWT Authentication
# IMPORTANT: Generate a secure secret key for production
# Example: openssl rand -hex 32
JWT_SECRET_KEY=your-secret-key-here
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=30
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7

# Minio Object Storage
# These will be provided by the orchestrator
MINIO_ENDPOINT=minio:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_SECURE=False
MINIO_BUCKET_LOGS=test-logs
MINIO_BUCKET_UPLOADS=test-uploads

# Redis (for Celery)
REDIS_URL=redis://redis:6379/0

# CORS Settings
CORS_ORIGINS=["http://localhost:3000", "http://localhost:3001"]

# Test Execution
MAX_CONCURRENT_EXECUTIONS=5
EXECUTION_TIMEOUT_SECONDS=3600

# File Upload Limits
MAX_UPLOAD_SIZE_MB=100
